# Скопируйте в .env и заполните. Не коммитьте .env.

# Приложение: demo | dev | prod
APP_ENV=dev
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql+asyncpg://mentor:mentor@postgres:5432/mentor360
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8000
SESSION_COOKIE_NAME=dis_session
CSRF_COOKIE_NAME=dis_csrf

# Telegram (polling по умолчанию)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=

# LLM: OpenAI-совместимый API. Пустой ключ или LLM_ENABLED=false → StubProvider
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MENTOR_MODEL=
LLM_EXAMINER_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1
LLM_TEMPERATURE_MENTOR=0.3
LLM_TEMPERATURE_EXAMINER=0.0
LLM_MAX_TOKENS=800

# Файлы / RAG
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_EXT=pdf,txt,md
RETRIEVAL_TOP_K=5

# Лимиты
RATE_LIMIT_TELEGRAM=20/minute
RATE_LIMIT_WEB=60/minute
EXAM_DEFAULT_ATTEMPT_LIMIT=2
PASS_SCORE_PERCENT=70

# Демо (фикционные пользователи, без реальных ПДн)
SEED_ON_START=true
